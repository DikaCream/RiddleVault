{
  "name": "riddlevault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RiddleVault - lock a prize behind a riddle; GenLayer AI validators judge every answer by consensus, with a bonded appeal round and refunds on expiry",
  "scripts": {
    "wallet:new": "node scripts/create-wallet.mjs",
    "schema": "node scripts/schema-check.mjs",
    "deploy:studionet": "node scripts/deploy.mjs",
    "e2e:studionet": "node scripts/e2e.mjs",
    "e2e:appeal": "node scripts/e2e-appeal.mjs",
    "lint:contract": "genvm-lint check contracts/riddlevault.py",
    "test:contract": "pytest tests/direct/ -v",
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "genlayer-js": "1.1.8"
  }
}
